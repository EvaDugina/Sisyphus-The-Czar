# false — slim production; true — production build с отладочной панелью и послаблением Origin.
# Флаг одновременно передаётся в Vite build и сервер, поэтому после смены нужен rebuild/recreate.
DEBUG=false

# Публичный origin без завершающего слеша. Несколько значений — через запятую.
# Если пусто, сервер принимает только Origin с тем же Host.
ALLOWED_ORIGIN=https://example.com

# Сколько секунд сессия хранится после последней активности.
SESSION_TTL_SECONDS=86400

# Задержка удаления пустой комнаты: хватает для reload/reconnect.
EMPTY_SESSION_GRACE_SECONDS=10

# Файл постоянного состояния комнат внутри Docker volume.
SESSION_STORE_PATH=/app/data/sessions.json

# Выбранный шаблон следующего slim production внутри отдельного общего volume.
PRODUCTION_PRESET_PATH=/app/config/production-preset.json

# Интервал фонового сохранения движущихся комнат, миллисекунды.
SESSION_PERSIST_INTERVAL_MS=250
