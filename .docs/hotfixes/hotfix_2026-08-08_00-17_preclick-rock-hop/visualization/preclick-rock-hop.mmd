flowchart LR
  u["Курсор входит в радиус камня"]
  speed["Скорость входа"]
  distance["Расчёт дальности"]
  hop["Отскок от курсора<br/>400 ms"]
  wrap["Бесшовный wrap<br/>в границах viewport"]
  sound["Один звук «Смех»<br/>на новый вход"]
  reentry["Выход и повторный вход"]
  grab["Первый успешный захват"]
  materialize["Материализация<br/>видимой позиции"]
  physics["Основная физика<br/>и camera-follow"]

  u --> speed --> distance --> hop
  hop --> wrap
  hop --> sound
  wrap --> reentry --> u
  wrap --> grab --> materialize --> physics

  classDef card fill:#f8fafc,stroke:#334155,color:#000,rx:10,ry:10;
  classDef outcome fill:#dcfce7,stroke:#166534,color:#000,rx:10,ry:10;
  class u,speed,distance,hop,wrap,sound,reentry,grab,materialize card;
  class physics outcome;
