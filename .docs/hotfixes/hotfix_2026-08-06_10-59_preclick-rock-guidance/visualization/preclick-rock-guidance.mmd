flowchart LR
  u(["Пользователь двигает указатель"])
  c["Штатно: рука видна сразу<br/>на fine pointer"]
  m["Runtime сцены<br/>и стили камня"]
  p["До первого primary-click:<br/>лёгкий parallax + рука по всей сцене"]
  k(["Первый клик по камню"])
  s["Parallax сброшен<br/>рука остаётся видимой"]
  e["Evidence: Playwright-сценарий<br/>и скриншоты"]
  r["Production regression smoke"]

  u --> c --> m --> p --> k --> s --> e --> r

  classDef card fill:#ffffff,stroke:#555555,color:#000000,rx:10,ry:10;
  classDef accent fill:#eef6ff,stroke:#2f6feb,color:#000000,rx:10,ry:10;
  classDef evidence fill:#effaf1,stroke:#2e7d32,color:#000000,rx:10,ry:10;
  class u,c,m,k,s,r card;
  class p accent;
  class e evidence;
